# ==========================================================================
# Loop7 — configuración de entorno
# Valores por defecto pensados para DESARROLLO local (funcionan sin Redis/S3).
# Para PRODUCCIÓN, revisa los bloques marcados con [PROD] y el checklist
# docs/19_CHECKLIST_SEGURIDAD_PREPROD.md + runbook docs/21_RUNBOOK_OPERACION.md.
# ==========================================================================

APP_NAME="Loop7 Social"
APP_ENV=local
APP_KEY=
# [PROD] APP_DEBUG=false SIEMPRE en producción.
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL del SPA (Vue). En prod: https://app.tudominio.com
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --------------------------------------------------------------------------
# Logging — [PROD] usa un canal estructurado (JSON) hacia stdout/stderr.
# --------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# [PROD] LOG_LEVEL=warning
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Base de datos (MySQL 8+). El motor se fuerza a InnoDB desde config/database.
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_saas
DB_USERNAME=social_saas
DB_PASSWORD=change_me
# DB_ENGINE="InnoDB ROW_FORMAT=DYNAMIC"

# --------------------------------------------------------------------------
# Sesión / cookies (Sanctum SPA)
# Local: driver database (sin Redis). [PROD] SESSION_DRIVER=redis.
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# En local déjalo vacío (sirve para localhost y 127.0.0.1). [PROD] .tudominio.com
SESSION_DOMAIN=
# [PROD] SESSION_SECURE_COOKIE=true (requiere HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Dominios que Sanctum trata como "stateful" (cookies). [PROD] app.tudominio.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# CORS: orígenes permitidos (coma-separados). [PROD] https://app.tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------
# Colas / caché / almacenamiento
# Local: database + disco local. [PROD] redis (+ Horizon) y s3.
# --------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Seguridad (headers) — ver App\Http\Middleware\SecurityHeaders
# --------------------------------------------------------------------------
# HSTS sólo se envía sobre HTTPS (irrelevante en local por HTTP).
SECURITY_HSTS=true
# SECURITY_HSTS_VALUE="max-age=31536000; includeSubDomains"
# CSP por defecto apta para API; el SPA define la suya en su hosting.
# SECURITY_CSP="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

# [PROD] Detrás de balanceador/CDN con TLS: '*' o lista de IP/CIDR de los proxies.
# Necesario para detectar HTTPS (HSTS, cookies Secure, URLs firmadas).
TRUSTED_PROXIES=

# --------------------------------------------------------------------------
# Correo — local: log (no envía). [PROD] SMTP real.
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@loop7.test"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Almacenamiento S3-compatible (media privada + URLs firmadas). [PROD]
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Proveedores externos (social/pagos/IA)
# Se habilitan y configuran (credenciales cifradas) desde el panel SUPERADMIN.
# Estas banderas son informativas; las claves NO se guardan en .env.
# --------------------------------------------------------------------------
STRIPE_ENABLED=false
MERCADOPAGO_ENABLED=false
OPENPAY_ENABLED=false
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
GEMINI_ENABLED=false
